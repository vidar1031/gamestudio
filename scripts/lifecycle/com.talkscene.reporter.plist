<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/Property1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gamestudio.reporter</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/ovokit2t/aiwork/gamestudio/scripts/lifecycle/reporter_email.sh</string>
    </array>
    
    <!-- 每 3 小时执行一次 (10800 秒) -->
    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>10800</integer>
    
    <key>StandardOutPath</key>
    <string>/tmp/gamestudio_reporter.log</string>
    
    <key>StandardErrorPath</key>
    <string>/tmp/gamestudio_reporter.err</string>
    
    <key>WorkingDirectory</key>
    <string>/Volumes/ovokit2t/aiwork/gamestudio</string>
</dict>
</plist>
