    {
      "id": "bn_sc_1774598421897_e1op40",
      "scriptCardId": "sc_1774598421897_e1op40",
      "name": "1后果1",
      "kind": "scene",
      "textDraft": "小猫放下鱼竿去追蝴蝶，在草地上跑啊跑，蝴蝶飞进花丛不见踪影。等它气喘吁吁回到湖边，发现浮漂早就不动了。鱼竿还孤零零地插在地上。",
      "actorIds": [],
      "eventIds": [],
      "choices": [
